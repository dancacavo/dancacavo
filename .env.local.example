# ─────────────────────────────────────────────────────────────────────────
# MS Investor — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Firebase. Nenhum valor aqui é secreto (todas as chaves do
# Firebase Web SDK são públicas por design — a segurança real vem das
# Firestore/Storage Security Rules), mas ainda assim não devem ser
# hardcoded no código-fonte.
#
# Sem estas variáveis preenchidas, a aplicação roda em MODO DEMONSTRAÇÃO:
# autenticação fica desativada e os dados exibidos são mockados/vazios.
# ─────────────────────────────────────────────────────────────────────────

# Firebase (Configurações do projeto > Geral > Seus apps > SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Plataforma parceira SONICA — URL para onde o botão "Investir" redireciona.
# Pode também ser sobrescrita por empreendimento (campo `investmentUrl`).
NEXT_PUBLIC_SONICA_INVESTMENT_URL=https://sonica.example.com/investir

# URL pública do site (usada em metadata, OpenGraph, sitemap e robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
